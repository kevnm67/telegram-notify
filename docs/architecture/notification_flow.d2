# telegram-notify orb — notification flow.
#
# Theme-safe on purpose: no style.fill / style.stroke hex values anywhere, so the one
# source renders correctly under any d2 theme. Emphasis comes from shape, stroke-dash,
# stroke-width and bold instead.
#
# Regenerate (see `make diagrams`):
#   d2 validate docs/architecture/notification_flow.d2
#   d2 --bundle --theme 200 --layout elk docs/architecture/notification_flow.d2 \
#      docs/architecture/notification_flow-dark.svg

direction: right

title: {
  label: telegram-notify — notification flow
  near: top-center
  shape: text
  style.font-size: 36
  style.underline: true
}

classes: {
  vcs: {
    icon: https://icons.terrastruct.com/dev/github.svg
    shape: image
  }
  step: {
    shape: rectangle
    style.border-radius: 8
    style.font-size: 22
  }
  # Anything the orb only reads from — dashed, never coloured.
  external: {
    shape: rectangle
    style.stroke-dash: 5
    style.font-size: 22
  }
  data: {
    shape: cylinder
    style.font-size: 22
  }
}

source: GitHub / Renovate {
  class: vcs
  label: ""
}

circleci: CircleCI job {
  class: step
  style.bold: true
}

orb: telegram-notify orb {
  style.font-size: 26

  cmd: "notify · notify_failure\nnotify_success" {class: step}
  script: "notify.sh\nfilter → status → fetch\n→ render → send" {
    class: step
    style.bold: true
  }
  marker: "record_failure.sh\nmarker for event: always" {class: external}
  templates: "templates\nbasic · test_summary · insights\nai_summary · deploy · custom" {class: data}

  cmd -> script: TELEGRAM_NOTIFY_* env {style.animated: true}
  marker -> script: job failed? {style.stroke-dash: 5}
  templates -> script: sections {style.stroke-dash: 5}
}

cci_api: "CircleCI API\nv1.1 step output · v2 job\nv2 tests · Insights" {class: external}
anthropic: "Anthropic Messages API\ntemplate: ai_summary" {class: external}
telegram: Telegram Bot API {class: step}
chat: "Telegram chat / topic" {class: step}

source -> circleci: push · PR · tag {style.animated: true}
circleci -> orb.cmd: step or post-step {style.animated: true}
orb.script -> cci_api: "GET failed output, duration,\ntests, insights (CIRCLE_TOKEN)" {style.stroke-dash: 5}
orb.script -> anthropic: "POST error tail (opt-in)" {style.stroke-dash: 5}
orb.script -> telegram: "sendMessage (HTML + buttons)\nsendDocument (attach_log)" {style.animated: true}
telegram -> chat: "🔴 failure · ✅ success · 🚀 release" {style.animated: true}
