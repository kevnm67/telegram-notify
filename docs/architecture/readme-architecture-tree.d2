(** -> **)[*].style.font-size: 14
# Generated from an ASCII directory tree by tree2d2.py. Edit freely; re-render with d2 (theme 200, elk).
direction: down

title: {
  label: "telegram-notify: Architecture"
  near: top-center
  shape: text
  style.font-size: 32
  style.underline: true
}

classes: {
  dir: { shape: rectangle; style.border-radius: 8; style.font-size: 16 }
  file: { shape: rectangle; style.border-radius: 8; style.stroke-dash: 4; style.font-size: 16 }
  note: { shape: text; style.font-size: 14 }
  ic: { shape: rectangle; style.border-radius: 8; style.font-size: 16; label.near: bottom-center; height: 150 }
}

grid-columns: 3
grid-gap: 40

g1: "commands/" {
  grid-columns: 1
  style.font-size: 18
  purpose: "generated by scripts/dev/generate-commands.py" { class: note }
  n2: "notify.yml\nevent-driven command (failure |\nsuccess | always)" { class: file }
  n3: "notify_failure.yml\nthin wrapper → notify(event:\nfailure)" { class: file }
  n4: "notify_success.yml\nthin wrapper → notify(event:\nsuccess)" { class: file }
}
g5: "scripts/" {
  grid-columns: 1
  style.font-size: 18
  icon: https://icons.terrastruct.com/tech/022-server.svg
  n6: "notify.sh\nall logic: filters, fetch,\ntemplates, render, send" { class: file }
  n7: "record_failure.sh\non_fail marker for event: always" { class: file }
}
g8: "examples/" {
  grid-columns: 1
  style.font-size: 18
  purpose: "usage examples shown in the orb registry" { class: note }
}
rootfiles: "root files" {
  grid-columns: 1
  style.font-size: 18
  n9: "@orb.yml\norb metadata" { class: file }
}
