#!/usr/bin/env bash
# Test double for curl. Records every invocation to $MOCK_CURL_LOG and
# answers from MOCK_* variables so the orb script can be exercised offline.
set -euo pipefail
printf '%s\n' "$*" >>"${MOCK_CURL_LOG:?}"
for a in "$@"; do
    case "$a" in @/*) printf 'body: %s\n' "$(cat "${a#@}")" >>"${MOCK_CURL_LOG}" ;; esac
done

url=""
out_file=""
want_code=false
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
    -o) out_file="${args[$((i + 1))]}" ;;
    -w) want_code=true ;;
    http://* | https://*) url="${args[$i]}" ;;
    esac
done

if [[ "${MOCK_CURL_EXIT:-0}" != "0" ]]; then
    exit "${MOCK_CURL_EXIT}"
fi

# Default payloads (set here because ${var:-{...}} cannot hold unescaped braces).
[[ -n "${MOCK_TELEGRAM_BODY:-}" ]] || MOCK_TELEGRAM_BODY='{"ok":true,"result":{"message_id":4242}}'
[[ -n "${MOCK_TELEGRAM_DOC_BODY:-}" ]] || MOCK_TELEGRAM_DOC_BODY='{"ok":true,"result":{"message_id":4243}}'
[[ -n "${MOCK_ANTHROPIC_BODY:-}" ]] || MOCK_ANTHROPIC_BODY='{"content":[{"type":"text","text":"SUMMARY: mock summary\nFIX: mock fix\nPROMPT: mock prompt"}]}'
[[ -n "${MOCK_TESTS_JSON:-}" ]] || MOCK_TESTS_JSON='{"items":[]}'
[[ -n "${MOCK_JOB_JSON:-}" ]] || MOCK_JOB_JSON='{"duration":133000}'
[[ -n "${MOCK_WORKFLOW_JSON:-}" ]] || MOCK_WORKFLOW_JSON='{"name":"build_and_test"}'
[[ -n "${MOCK_FLAKY_JSON:-}" ]] || MOCK_FLAKY_JSON='{"total_flaky_tests":2}'

reply() { # $1 body, $2 http code
    if [[ -n "$out_file" ]]; then
        printf '%s' "$1" >"$out_file"
    else
        printf '%s' "$1"
    fi
    if [[ "$want_code" == true ]]; then
        printf '%s' "$2"
    fi
}

case "$url" in
*/sendMessage)
    reply "$MOCK_TELEGRAM_BODY" "${MOCK_HTTP_CODE:-200}"
    ;;
*/sendDocument)
    reply "$MOCK_TELEGRAM_DOC_BODY" "${MOCK_DOC_HTTP_CODE:-200}"
    ;;
*/v1/messages)
    # MOCK_ANTHROPIC_FIRST_BODY: answer the first call with it, later calls with MOCK_ANTHROPIC_BODY.
    if [[ -n "${MOCK_ANTHROPIC_FIRST_BODY:-}" && ! -f "${MOCK_CURL_LOG}.ai-called" ]]; then
        touch "${MOCK_CURL_LOG}.ai-called"
        reply "$MOCK_ANTHROPIC_FIRST_BODY" "${MOCK_ANTHROPIC_HTTP_CODE:-200}"
    else
        reply "$MOCK_ANTHROPIC_BODY" "${MOCK_ANTHROPIC_HTTP_CODE:-200}"
    fi
    ;;
*/api/v2/*/tests)
    printf '%s' "$MOCK_TESTS_JSON"
    ;;
*/api/v2/*/job/*)
    printf '%s' "$MOCK_JOB_JSON"
    ;;
*/api/v2/workflow/*)
    printf '%s' "$MOCK_WORKFLOW_JSON"
    ;;
*/api/v2/insights/*/flaky-tests*)
    printf '%s' "$MOCK_FLAKY_JSON"
    ;;
*/api/v2/insights/*/summary*)
    printf '%s' "${MOCK_INSIGHTS_JSON:-}"
    ;;
*/api/v1.1/*)
    printf '%s' "${MOCK_CIRCLE_BUILD_JSON:-}"
    ;;
*step-output*)
    printf '%s' "${MOCK_STEP_OUTPUT:-}"
    ;;
*)
    echo "mock curl: unexpected URL ${url}" >&2
    exit 22
    ;;
esac
