{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(bats *)",
      "Bash(shellcheck *)",
      "Bash(circleci *)",
      "Bash(yamllint *)",
      "Bash(qlty *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(docker run *)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--force*)",
      "Bash(*TELEGRAM_BOT_TOKEN=*)",
      "Bash(circleci orb publish * production*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-gate.sh"
          }
        ]
      }
    ]
  }
}
